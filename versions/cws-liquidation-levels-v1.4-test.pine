//@version=6
indicator("CWS Liquidation Levels - TV Reconstruction v1.4 TEST", overlay = true, max_lines_count = 500, max_labels_count = 500)

// TradingView OHLC + OI only. No imported reference prices / external API.
// OI impulse size is NOT the size of an individual trader position.
// Reconstruction hypothesis, NOT extracted Hyblock/Leviathan source.
// Color = side + leverage shade; width = relative OI event class.
// No hardcoded screenshot prices; no fitted/verified Hyblock agreement.
// Never delete drawings on a touch, expiry, distance change or capacity limit.
// At capacity, STOP allocation. Change start time / settings to rebuild the dataset.

string oiSymbol = input.symbol("BINANCE:BTCUSDT.P_OI", "OI symbol", group = "TradingView data")
string oiUnit = input.string("BTC", "OI unit (verify feed)", options = ["BTC", "USD"], group = "TradingView data")
float btcPerUnit = input.float(1.0, "BTC per OI unit", minval = 0.00000001, group = "TradingView data")
int analysisStart = input.time(timestamp("22 Oct 2026 00:00 +0000"), "Analysis starts (UTC)", group = "TradingView data")
string entryMethod = input.string("HALF", "Assumed entry price", options = ["HALF", "Close", "HLC3", "VWMA"], group = "TradingView data")
int entryLength = input.int(30, "VWMA length", minval = 1, maxval = 500, group = "TradingView data")
string signalSource = input.string("OI+VOL", "Experimental event model", options = ["OI", "OI+VOL", "OI+CVD"], group = "Event model")
int statsLength = input.int(150, "Prior-bar statistical window", minval = 20, maxval = 1000, group = "Event model")
float smallK = input.float(1.2, "Small event score from", minval = 0.1, step = 0.1, group = "Event model")
float mediumK = input.float(2.0, "Medium event score from", minval = 0.1, step = 0.1, group = "Event model")
float largeK = input.float(3.0, "Large event score from", minval = 0.1, step = 0.1, group = "Event model")
float sensitivity = input.float(1.0, "Threshold multiplier", minval = 0.1, step = 0.1, group = "Event model")
float minUsdM = input.float(1.0, "Additional absolute OI floor (Mio USD)", minval = 0.0, step = 0.5, group = "Event model")
float minParticipation = input.float(0.0, "Minimum delta OI / volume (0 = off)", minval = 0.0, maxval = 1.0, step = 0.01, group = "Event model")
string sideModel = input.string("Both sides", "Side hypothesis", options = ["Both sides", "Delta consensus", "Price proxy"], group = "Direction / delta")
int cvdLength = input.int(30, "Rolling delta window (chart bars)", minval = 1, maxval = 500, group = "Direction / delta")
float deltaThreshold = input.float(0.10, "Minimum absolute delta / volume", minval = 0.0, maxval = 1.0, step = 0.01, group = "Direction / delta")
float maintenancePct = input.float(0.0, "Assumed maintenance margin (%)", minval = 0.0, maxval = 1.0, step = 0.05, group = "Leverage assumptions", tooltip = "0 = simple 1/leverage distance. Hypothesis only, not the exchange's actual risk tier. Must be below 100/leverage for every enabled scenario.")

// Side/lever shades are a display choice inspired by the reference, not decoded colors.
color longHighColor = color.rgb(65, 220, 100)
color longMediumColor = color.rgb(116, 236, 135)
color longLowColor = color.rgb(173, 245, 169)
color shortHighColor = color.rgb(255, 55, 65)
color shortMediumColor = color.rgb(255, 110, 115)
color shortLowColor = color.rgb(255, 170, 170)

bool useHigh = input.bool(true, "Show scenario A", inline = "a", group = "Leverage assumptions")
int levHigh = input.int(100, "x", minval = 2, inline = "a", group = "Leverage assumptions")
bool useMedium = input.bool(true, "Show scenario B", inline = "b", group = "Leverage assumptions")
int levMedium = input.int(50, "x", minval = 2, inline = "b", group = "Leverage assumptions")
bool useLow = input.bool(true, "Show scenario C", inline = "c", group = "Leverage assumptions")
int levLow = input.int(25, "x", minval = 2, inline = "c", group = "Leverage assumptions")

float minGapUsd = input.float(50.0, "Minimum spacing / side / leverage (USD)", minval = 0.0, step = 1.0, group = "History / display", tooltip = "Only active levels with the same side and numeric leverage are compared, across all OI size colors. 0 disables deduplication. Nothing is merged or summed.")
float maxDistance = input.float(15.0, "Maximum distance at CREATION (%)", minval = 0.1, maxval = 100.0, group = "History / display")
int lifetimeDays = input.int(0, "Active lifetime (days; 0 = unlimited)", minval = 0, maxval = 3650, group = "History / display", tooltip = "Expiry stops the line and marks AGE. The drawing stays visible. A later touch is not counted after expiry.")
int maxLevels = input.int(500, "Total drawing limit (active + history)", minval = 10, maxval = 500, group = "History / display")
bool showLabels = input.bool(false, "Show compact price labels", group = "History / display")
bool showHistoryLabels = input.bool(false, "Keep text on ended levels", group = "History / display", tooltip = "When off, ended labels remain allocated but their text is cleared. Lines are always retained.")
int historyTransparency = input.int(15, "Ended line transparency", minval = 0, maxval = 90, group = "History / display")
bool diagnostic = input.bool(true, "Extra OI diagnostics", group = "Analysis")

type Level
    line ln
    label lb
    float price
    int birthBar
    int birthTime
    bool longSide
    int leverage
    int sizeClass
    color baseColor
    string caption
    int status
    // status: 0 active, 1 touched by bar range, 2 expired, 3 crossed in a gap

var array<Level> levels = array.new<Level>()

isDuplicate(float price, bool longSide, int leverage) =>
    bool duplicate = false
    int index = 0
    while index < array.size(levels) and not duplicate
        Level current = array.get(levels, index)
        duplicate := current.status == 0 and current.longSide == longSide and current.leverage == leverage and math.abs(current.price - price) < minGapUsd
        index += 1
    duplicate

addLevel(float entry, bool longSide, int leverage, int sizeClass, float impulseM) =>
    float maintenance = maintenancePct / 100.0
    float rawPrice = longSide ? entry * (1.0 - 1.0 / leverage) / (1.0 - maintenance) : entry * (1.0 + 1.0 / leverage) / (1.0 + maintenance)
    float price = math.round_to_mintick(rawPrice)
    bool correctSide = longSide ? price < close : price > close
    // Result 1: created, 0: filtered/duplicate, -1: full. No eviction.
    int result = 0
    if price > 0 and correctSide and math.abs(price / close - 1.0) * 100.0 <= maxDistance
        if not isDuplicate(price, longSide, leverage)
            if array.size(levels) >= maxLevels
                result := -1
            else
                color levelColor = longSide ? (leverage == levHigh ? longHighColor : leverage == levMedium ? longMediumColor : longLowColor) : (leverage == levHigh ? shortHighColor : leverage == levMedium ? shortMediumColor : shortLowColor)
                string sizeText = sizeClass == 0 ? "small" : sizeClass == 1 ? "medium" : "large"
                string caption = (longSide ? "L" : "S") + " OI-" + sizeText + " | assumed " + str.tostring(leverage) + "x | ~" + str.tostring(impulseM, "0.00") + "M OI+"
                line ln = line.new(x1 = time_close, y1 = price, x2 = time_close + 1, y2 = price, xloc = xloc.bar_time, extend = extend.none, color = levelColor, style = line.style_dotted, width = sizeClass + 1)
                label lb = na
                if showLabels
                    color textColor = color.black
                    lb := label.new(x = time_close, y = price, text = str.tostring(price, format.mintick), xloc = xloc.bar_time, yloc = yloc.price, style = label.style_label_left, color = levelColor, textcolor = textColor, size = size.tiny)
                    label.set_tooltip(lb, "Scenario price: " + str.tostring(price, format.mintick) + ". OI+ is the WHOLE bar's estimated NET increase, repeated across leverage scenarios. Do NOT sum labels. Neither a measured trader size nor actual liquidation volume.")
                array.push(levels, Level.new(ln, lb, price, bar_index, time_close, longSide, leverage, sizeClass, levelColor, caption, 0))
                result := 1
    result

bool contextOk = syminfo.prefix == "BINANCE" and syminfo.ticker == "BTCUSDT.P" and chart.is_standard and timeframe.isminutes and (timeframe.multiplier == 5 or timeframe.multiplier == 15)
bool thresholdsOk = smallK < mediumK and mediumK < largeK
bool marginOk = (not useHigh or maintenancePct < 100.0 / levHigh) and (not useMedium or maintenancePct < 100.0 / levMedium) and (not useLow or maintenancePct < 100.0 / levLow)
bool scenariosOk = useHigh or useMedium or useLow
[oi, oiTime] = request.security(oiSymbol, timeframe.period, [close, time], gaps = barmerge.gaps_on, lookahead = barmerge.lookahead_off, ignore_invalid_symbol = true)
bool oiAvailable = not na(oi) and oi >= 0 and not na(oiTime) and oiTime == time
bool oiPairValid = oiAvailable and not na(oi[1]) and oi[1] >= 0 and not na(oiTime[1]) and oiTime[1] == time[1]
float oiDelta = oiPairValid ? oi - oi[1] : na
float notionalDelta = oiUnit == "BTC" ? oiDelta * btcPerUnit * close : oiDelta
float impulseM = notionalDelta / 1000000.0
float vwmaEntry = ta.vwma(hlc3, entryLength)
float assumedEntry = entryMethod == "HALF" ? hl2 : entryMethod == "Close" ? close : entryMethod == "HLC3" ? hlc3 : vwmaEntry

// Hypothesis: positive NET OI innovations, standardized against PRIOR bars only.
float positiveImpulse = oiPairValid ? math.max(impulseM, 0.0) : na
float priorMean = ta.sma(positiveImpulse[1], statsLength)
float priorSd = ta.stdev(positiveImpulse[1], statsLength)
float priorVolume = ta.sma(volume[1], statsLength)
float validHistory = math.sum(oiPairValid[1] ? 1.0 : 0.0, statsLength)
bool historyReady = not na(validHistory) and validHistory == statsLength and not na(priorSd) and priorSd > 0
float zOi = historyReady ? (positiveImpulse - priorMean) / priorSd : na
float relativeVolume = not na(volume) and not na(priorVolume) and priorVolume > 0 ? volume / priorVolume : na
// Chart volume on the target linear BTC contract is assumed to be in BTC.
float deltaOiBtc = oiUnit == "BTC" ? oiDelta * btcPerUnit : oiDelta / close
float participation = not na(volume) and volume > 0 ? deltaOiBtc / volume : na

// Free 1m price-classified delta approximation, not exchange bid/ask tape.
signedIntrabarVolume() =>
    int direction = 0
    direction := close > open ? 1 : close < open ? -1 : close > close[1] ? 1 : close < close[1] ? -1 : nz(direction[1], 0)
    volume * direction

[deltaParts, volumeParts] = request.security_lower_tf(syminfo.tickerid, "1", [signedIntrabarVolume(), volume])
float intrabarVolume = array.sum(volumeParts)
bool deltaAvailable = array.size(deltaParts) >= timeframe.multiplier and not na(intrabarVolume) and intrabarVolume > 0
float deltaVolume = deltaAvailable ? array.sum(deltaParts) : na
float deltaShare = deltaAvailable ? deltaVolume / intrabarVolume : na
float validDeltaHistory = math.sum(deltaAvailable ? 1.0 : 0.0, cvdLength)
float cvdVolume = math.sum(intrabarVolume, cvdLength)
float cvdDelta = math.sum(deltaVolume, cvdLength)
bool cvdReady = not na(validDeltaHistory) and validDeltaHistory == cvdLength and not na(cvdVolume) and cvdVolume > 0
float cvdShare = cvdReady ? cvdDelta / cvdVolume : na
// Disclosed experimental combinations; NOT the undisclosed Leviathan formulas.
float eventScore = signalSource == "OI" ? zOi : signalSource == "OI+VOL" ? zOi * math.sqrt(relativeVolume) : cvdReady ? zOi * (1.0 + math.abs(cvdShare)) : na
int deltaDirection = deltaAvailable and cvdReady ? (deltaShare > deltaThreshold and cvdShare > 0 and close > close[1] ? 1 : deltaShare < -deltaThreshold and cvdShare < 0 and close < close[1] ? -1 : 0) : 0
int priceDirection = close > close[1] ? 1 : close < close[1] ? -1 : 0
int sideDirection = sideModel == "Delta consensus" ? deltaDirection : priceDirection
bool participationOk = minParticipation == 0 or (not na(participation) and participation >= minParticipation)

var int capacitySkipped = 0
var int acceptedEvents = 0
var int ambiguousEvents = 0
var int lastCreationTime = na
var float confirmedScore = na
var float confirmedParticipation = na
var float confirmedDeltaShare = na
var bool confirmedHistoryReady = false
var float confirmedOi = na
var float confirmedDelta = na
var float confirmedImpulse = na
var float confirmedClose = na
var bool confirmedAvailable = false
var bool confirmedPair = false
var int confirmedTime = na
var string priceOiState = "Waiting for confirmed data"

if barstate.isconfirmed
    // Only mutate confirmed bars. Creation-bar extremes cannot hit a new level.
    int index = 0
    while index < array.size(levels)
        Level current = array.get(levels, index)
        if current.status == 0
            line.set_x2(current.ln, time_close)
            bool crossed = bar_index > current.birthBar and (current.longSide ? low <= current.price : high >= current.price)
            bool inRange = low <= current.price and high >= current.price
            bool expired = lifetimeDays > 0 and time_close - current.birthTime >= lifetimeDays * 86400000
            // Price crossing takes priority on the expiry candle; sequence inside
            // the candle is unavailable. A gap crossing is reported separately.
            if crossed or expired
                current.status := crossed ? (inRange ? 1 : 3) : 2
                line.set_extend(current.ln, extend.none)
                line.set_x2(current.ln, time_close)
                line.set_color(current.ln, color.new(current.baseColor, historyTransparency))
                if not na(current.lb)
                    string suffix = current.status == 1 ? " [HIT]" : current.status == 3 ? " [GAP]" : " [AGE]"
                    label.set_x(current.lb, time_close)
                    label.set_text(current.lb, showHistoryLabels ? current.caption + suffix : "")
                    label.set_color(current.lb, color.new(current.baseColor, showHistoryLabels ? historyTransparency : 100))
        index += 1

    bool newImpulse = contextOk and thresholdsOk and marginOk and scenariosOk and time >= analysisStart and historyReady and participationOk and not na(eventScore) and eventScore >= smallK * sensitivity and impulseM > 0 and impulseM >= minUsdM and not na(assumedEntry)
    if newImpulse
        int sizeClass = eventScore >= largeK * sensitivity ? 2 : eventScore >= mediumK * sensitivity ? 1 : 0
        int created = 0
        // Both sides explicitly models the two counterparties of new open interest.
        // Directional modes select a proxy; they do not prove actual position sides.
        if sideModel != "Both sides" and sideDirection == 0
            ambiguousEvents += 1
        int sideIndex = 0
        while sideIndex < 2
            bool longSide = sideIndex == 0
            bool permitted = sideModel == "Both sides" or (longSide ? sideDirection == 1 : sideDirection == -1)
            if permitted
                if useHigh
                    int result = addLevel(assumedEntry, longSide, levHigh, sizeClass, impulseM)
                    created += result == 1 ? 1 : 0
                    capacitySkipped += result == -1 ? 1 : 0
                if useMedium
                    int result = addLevel(assumedEntry, longSide, levMedium, sizeClass, impulseM)
                    created += result == 1 ? 1 : 0
                    capacitySkipped += result == -1 ? 1 : 0
                if useLow
                    int result = addLevel(assumedEntry, longSide, levLow, sizeClass, impulseM)
                    created += result == 1 ? 1 : 0
                    capacitySkipped += result == -1 ? 1 : 0
            sideIndex += 1
        acceptedEvents += created > 0 ? 1 : 0
        if created > 0
            lastCreationTime := time_close

    if barstate.islast or barstate.islastconfirmedhistory
        int labelIndex = 0
        while labelIndex < array.size(levels)
            Level current = array.get(levels, labelIndex)
            if current.status == 0 and not na(current.lb)
                label.set_x(current.lb, time_close)
            labelIndex += 1

    confirmedScore := eventScore
    confirmedParticipation := participation
    confirmedDeltaShare := deltaShare
    confirmedHistoryReady := historyReady
    confirmedOi := oiAvailable ? oi : na
    confirmedDelta := oiDelta
    confirmedImpulse := impulseM
    confirmedClose := close
    confirmedAvailable := oiAvailable
    confirmedPair := oiPairValid
    confirmedTime := time_close
    priceOiState := not oiPairValid ? "OI unavailable / gap" : oiDelta > 0 ? (close > close[1] ? "Price up / OI up: long proxy" : close < close[1] ? "Price down / OI up: short proxy" : "OI up / price unchanged") : oiDelta < 0 ? (close > close[1] ? "Price up / OI down: net reduction" : close < close[1] ? "Price down / OI down: net reduction" : "OI down / price unchanged") : "OI unchanged"

formatNumber(float value) =>
    na(value) ? "n/a" : str.tostring(value, "0.###")

describeLevel(float price, float reference) =>
    na(price) or na(reference) ? "none" : str.tostring(price, format.mintick) + " (" + str.tostring(math.abs(price / reference - 1.0) * 100.0, "0.00") + "%)"

var table panel = table.new(position.top_right, 2, 12, bgcolor = color.new(color.black, 10), border_width = 1)
if barstate.islast
    int activeLongs = 0
    int activeShorts = 0
    int hits = 0
    int gaps = 0
    int aged = 0
    float nearestLong = na
    float nearestShort = na
    int index = 0
    while index < array.size(levels)
        Level current = array.get(levels, index)
        if current.status == 0
            if current.longSide
                activeLongs += 1
                if current.price < confirmedClose and (na(nearestLong) or current.price > nearestLong)
                    nearestLong := current.price
            else
                activeShorts += 1
                if current.price > confirmedClose and (na(nearestShort) or current.price < nearestShort)
                    nearestShort := current.price
        else if current.status == 1
            hits += 1
        else if current.status == 3
            gaps += 1
        else
            aged += 1
        index += 1
    string warning = not contextOk ? "Use Binance BTCUSDT.P / standard / 5m or 15m" : not thresholdsOk ? "Set small < medium < large" : not marginOk ? "Maintenance assumption too high for leverage" : not scenariosOk ? "Enable at least one leverage scenario" : not confirmedAvailable ? "WARNING: missing / invalid OI" : not confirmedPair ? "WARNING: no consecutive OI pair" : not confirmedHistoryReady ? "Warmup: need consecutive OI history / nonzero SD" : array.size(levels) >= maxLevels ? "FULL: stopped; move start forward to rebuild" : signalSource == "OI+CVD" and na(confirmedScore) ? "CVD window missing: no event generation" : sideModel == "Delta consensus" and na(confirmedDeltaShare) ? "Delta unavailable: no side selection" : "Experimental reconstruction / confirmed TV bars"
    table.clear(panel, 0, 0, 1, 11)
    table.cell(panel, 0, 0, "CWS TV v1.4", text_color = color.white)
    table.cell(panel, 1, 0, warning, text_color = color.orange)
    table.cell(panel, 0, 1, "Price / OI analysis", text_color = color.white)
    table.cell(panel, 1, 1, priceOiState, text_color = color.white)
    table.cell(panel, 0, 2, "Active L / S (scenarios)", text_color = color.white)
    table.cell(panel, 1, 2, str.tostring(activeLongs) + " / " + str.tostring(activeShorts), text_color = color.white)
    table.cell(panel, 0, 3, "Nearest long proxy below", text_color = color.white)
    table.cell(panel, 1, 3, describeLevel(nearestLong, confirmedClose), text_color = color.aqua)
    table.cell(panel, 0, 4, "Nearest short proxy above", text_color = color.white)
    table.cell(panel, 1, 4, describeLevel(nearestShort, confirmedClose), text_color = color.orange)
    table.cell(panel, 0, 5, "Kept HIT / GAP / AGE", text_color = color.white)
    table.cell(panel, 1, 5, str.tostring(hits) + " / " + str.tostring(gaps) + " / " + str.tostring(aged), text_color = color.white)
    table.cell(panel, 0, 6, "Drawings / cap | skipped", text_color = color.white)
    table.cell(panel, 1, 6, str.tostring(array.size(levels)) + " / " + str.tostring(maxLevels) + " | " + str.tostring(capacitySkipped), text_color = color.white)
    table.cell(panel, 0, 7, "Model / direction", text_color = color.white)
    table.cell(panel, 1, 7, signalSource + " / " + sideModel, text_color = color.white)
    table.cell(panel, 0, 8, "Model limitation", text_color = color.white)
    table.cell(panel, 1, 8, "Green L / Red S; shade=leverage; width=relative event size", text_color = color.yellow)
    if diagnostic
        table.cell(panel, 0, 9, "Score / OIDV / delta-share", text_color = color.white)
        table.cell(panel, 1, 9, formatNumber(confirmedScore) + " / " + formatNumber(confirmedParticipation) + " / " + formatNumber(confirmedDeltaShare), text_color = color.white)
        table.cell(panel, 0, 10, "OI impulse / events / unclear", text_color = color.white)
        table.cell(panel, 1, 10, formatNumber(confirmedImpulse) + "M / " + str.tostring(acceptedEvents) + " / " + str.tostring(ambiguousEvents), text_color = color.white)
        table.cell(panel, 0, 11, "Last close / creation (UTC)", text_color = color.white)
        table.cell(panel, 1, 11, (na(confirmedTime) ? "n/a" : str.format_time(confirmedTime, "MM-dd HH:mm", "UTC")) + " / " + (na(lastCreationTime) ? "none" : str.format_time(lastCreationTime, "MM-dd HH:mm", "UTC")), text_color = color.white)

// Data Window contains raw signed observations for inspection/export.
plot(barstate.isconfirmed ? oi : na, "TV OI raw (confirmed)", display = display.data_window)
plot(barstate.isconfirmed ? oiDelta : na, "TV OI delta (confirmed)", display = display.data_window)
plot(barstate.isconfirmed ? impulseM : na, "Estimated delta notional (Mio USD)", display = display.data_window)

plot(barstate.isconfirmed ? eventScore : na, "Experimental event score", display = display.data_window)
plot(barstate.isconfirmed ? participation : na, "Delta OI / chart volume (unit assumption)", display = display.data_window)
plot(barstate.isconfirmed ? deltaShare : na, "Estimated 1m volume delta share", display = display.data_window)
plot(barstate.isconfirmed ? assumedEntry : na, "Assumed entry", display = display.data_window)
plot(barstate.isconfirmed ? confirmedOi : na, "Aligned OI", display = display.data_window)

// Comparison-only export columns. Event prices are ACTUALLY CREATED drawings,
// not unfiltered candidate prices. Existing event logic remains unchanged.
float newLongA = na
float newLongB = na
float newLongC = na
float newShortA = na
float newShortB = na
float newShortC = na
float creationCloseUtcMs = na
if barstate.isconfirmed
    int exportIndex = 0
    while exportIndex < array.size(levels)
        Level current = array.get(levels, exportIndex)
        if current.birthBar == bar_index
            creationCloseUtcMs := float(current.birthTime)
            if current.longSide
                if current.leverage == levHigh
                    newLongA := current.price
                if current.leverage == levMedium
                    newLongB := current.price
                if current.leverage == levLow
                    newLongC := current.price
            else
                if current.leverage == levHigh
                    newShortA := current.price
                if current.leverage == levMedium
                    newShortB := current.price
                if current.leverage == levLow
                    newShortC := current.price
        exportIndex += 1
plot(newLongA, "Created long A (default 100x)", display = display.data_window)
plot(newLongB, "Created long B (default 50x)", display = display.data_window)
plot(newLongC, "Created long C (default 25x)", display = display.data_window)
plot(newShortA, "Created short A (default 100x)", display = display.data_window)
plot(newShortB, "Created short B (default 50x)", display = display.data_window)
plot(newShortC, "Created short C (default 25x)", display = display.data_window)
plot(creationCloseUtcMs, "Creation close UTC milliseconds", display = display.data_window)
plot(barstate.isconfirmed ? array.size(levels) : na, "Stored drawings active plus history", display = display.data_window)
plot(barstate.isconfirmed ? capacitySkipped : na, "Candidates skipped at capacity cumulative", display = display.data_window)
